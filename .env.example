# Скопируйте этот файл в .env рядом с ним и заполните значения.
# install.sh делает это автоматически и сам генерирует секреты —
# руками редактировать нужно только если что-то меняете после установки.

# --- Домен и образы ---
DOMAIN=attest0.ru
ACME_EMAIL=admin@attest0.ru
GHCR_OWNER=your-github-org
IMAGE_TAG=latest

# --- База данных (создаётся автоматически контейнером db) ---
DB_NAME=attesto
DB_USER=attesto
DB_PASSWORD=change-me-generated-by-install-sh

# --- Секрет приложения (сессии/токены). Минимум 32 символа. ---
SECRET_KEY=change-me-generated-by-install-sh

# --- Почта. Без реального SMTP письма (подтверждение регистрации,
#     сброс пароля, уведомления по тикетам) не будут доставляться. ---
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Attest0

# --- Антибот-защита регистрации: Yandex SmartCaptcha.
# Создайте капчу в Yandex Cloud, вставьте client_key и server_key.
# После включения SMARTCAPTCHA_REQUIRED=true backend не запустится без ключей,
# чтобы случайно не открыть публичную регистрацию без капчи. ---
SMARTCAPTCHA_REQUIRED=false
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_VALIDATE_URL=https://smartcaptcha.cloud.yandex.ru/validate

# --- Вложения ---
MAX_LOGO_SIZE_MB=2
MAX_ATTACHMENT_SIZE_MB=20

# --- Оплата. stub + заполненные INVOICE_PAYEE_* ниже = боевой режим
#     "только оплата по счёту" (безопасно: онлайн-чекап и вебхук
#     заглушки явно отключены на backend в production). Когда появятся
#     ключи ЮKassa (их не выдают без уже работающего сайта с офертой) —
#     переключите на yookassa, оплата по счёту продолжит работать. ---
PAYMENT_PROVIDER=stub
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# --- Оплата по счёту (банковский перевод, подтверждается вручную в
#     /platform). В режиме PAYMENT_PROVIDER=stub это единственный
#     рабочий способ оплаты — заполните обязательно. ---
INVOICE_PAYEE_NAME=
INVOICE_PAYEE_INN=
INVOICE_PAYEE_ACCOUNT=
INVOICE_PAYEE_BANK=
